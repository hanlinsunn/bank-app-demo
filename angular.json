{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "libs",
  "projects": {
    "online-banking": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/online-banking",
      "sourceRoot": "apps/online-banking/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/online-banking",
            "index": "apps/online-banking/src/index.html",
            "main": "apps/online-banking/src/main.ts",
            "polyfills": "apps/online-banking/src/polyfills.ts",
            "tsConfig": "apps/online-banking/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "apps/online-banking/src/favicon.ico",
              "apps/online-banking/src/assets"
            ],
            "styles": [
              "apps/online-banking/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kb",
                  "maximumError": "8kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "apps/online-banking/src/environments/environment.ts",
                  "with": "apps/online-banking/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "online-banking:build:production"
            },
            "development": {
              "buildTarget": "online-banking:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "online-banking:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "apps/online-banking/src/test.ts",
            "polyfills": "apps/online-banking/src/polyfills.ts",
            "tsConfig": "apps/online-banking/tsconfig.spec.json",
            "karmaConfig": "apps/online-banking/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "apps/online-banking/src/favicon.ico",
              "apps/online-banking/src/assets"
            ],
            "styles": [
              "apps/online-banking/src/styles.scss"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "apps/online-banking/**/*.ts",
              "apps/online-banking/**/*.html"
            ]
          }
        }
      }
    },
    "credit-card-portal": {
