            "karmaConfig": "libs/boa-design-system/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "libs/boa-design-system/**/*.ts",
              "libs/boa-design-system/**/*.html"
            ]
          }
        }
      }
    },
    "integrations": {
      "projectType": "library",
      "root": "libs/integrations",
      "sourceRoot": "libs/integrations/src",
      "prefix": "boa",
      "architect": {
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "libs/integrations/src/test.ts",
            "tsConfig": "libs/integrations/tsconfig.spec.json",
            "karmaConfig": "libs/integrations/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "libs/integrations/**/*.ts",
              "libs/integrations/**/*.html"
            ]
          }
        }
      }
    },
    "banking-data": {
      "projectType": "library",
      "root": "libs/banking-data",
      "sourceRoot": "libs/banking-data/src",
      "prefix": "boa",
      "architect": {
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "libs/banking-data/src/test.ts",
            "tsConfig": "libs/banking-data/tsconfig.spec.json",
            "karmaConfig": "libs/banking-data/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "libs/banking-data/**/*.ts",
              "libs/banking-data/**/*.html"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    }
  }
}
