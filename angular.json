            "tsConfig": "apps/credit-card-portal/tsconfig.spec.json",
            "karmaConfig": "apps/credit-card-portal/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "apps/credit-card-portal/src/favicon.ico",
              "apps/credit-card-portal/src/assets"
            ],
            "styles": [
              "apps/credit-card-portal/src/styles.scss"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "apps/credit-card-portal/**/*.ts",
              "apps/credit-card-portal/**/*.html"
            ]
          }
        }
      }
    },
    "boa-design-system": {
      "projectType": "library",
      "root": "libs/boa-design-system",
      "sourceRoot": "libs/boa-design-system/src",
      "prefix": "boa",
