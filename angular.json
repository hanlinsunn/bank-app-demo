            "polyfills": "apps/credit-card-portal/src/polyfills.ts",
            "tsConfig": "apps/credit-card-portal/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "apps/credit-card-portal/src/favicon.ico",
