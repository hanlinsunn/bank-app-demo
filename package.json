{
  "name": "boa-digital-banking",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:banking",
    "start:banking": "ng serve online-banking",
    "start:credit": "ng serve credit-card-portal",
    "start:all": "run-p start:banking start:credit",
    "build": "npm run build:all",
    "build:banking": "ng build online-banking",
    "build:credit": "ng build credit-card-portal",
    "build:all": "run-s build:banking build:credit",
    "test": "run-s test:banking test:credit test:design-system test:integrations test:banking-data",
    "test:banking": "ng test online-banking --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:credit": "ng test credit-card-portal --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:design-system": "ng test boa-design-system --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:integrations": "ng test integrations --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:banking-data": "ng test banking-data --watch=false --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.2.0",
    "@angular/cdk": "^14.2.7",
    "@angular/common": "^14.2.0",
    "@angular/compiler": "^14.2.0",
    "@angular/core": "^14.2.0",
    "@angular/forms": "^14.2.0",
    "@angular/material": "^14.2.7",
    "@angular/platform-browser": "^14.2.0",
    "@angular/platform-browser-dynamic": "^14.2.0",
    "@angular/router": "^14.2.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.13",
    "@angular-eslint/builder": "14.4.0",
    "@angular-eslint/eslint-plugin": "14.4.0",
    "@angular-eslint/eslint-plugin-template": "14.4.0",
    "@angular-eslint/schematics": "14.4.0",
    "@angular-eslint/template-parser": "14.4.0",
    "@angular/cli": "~14.2.13",
    "@angular/compiler-cli": "^14.2.0",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^16.18.126",
    "@typescript-eslint/eslint-plugin": "5.43.0",
    "@typescript-eslint/parser": "5.43.0",
    "eslint": "^8.28.0",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~4.7.2"
  }
}
